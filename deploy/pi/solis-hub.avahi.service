<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!-- install.sh replaces @HUB_ID@ with the hub's identity and @PORT@ with the
     listen_port in hub.json, so an upgrade keeps a custom port advertised. Avahi advertises it so
     the Python code needs no mDNS of its own. -->
<service-group>
  <name replace-wildcards="yes">Solis hub on %h</name>
  <service>
    <type>_solis-hub._tcp</type>
    <port>@PORT@</port>
    <txt-record>hub_id=@HUB_ID@</txt-record>
    <txt-record>proto=1</txt-record>
  </service>
</service-group>
